# WirkVektor — Deployment-Zugang
# Kopie als .env.deploy speichern (nicht committen, wird durch .gitignore ignoriert).

SFTP_HOST=www639.your-server.de
SFTP_USER=kistiz_0
SFTP_PASS=hier-passwort-eintragen
# Webroot bei Hetzner Webhosting — typischerweise einer von:
#   /public_html
#   /html
#   /wirkvektor.de       (wenn die Domain als separates Verzeichnis konfiguriert ist)
# Im KonsoleH unter "Domains" prüfen, welches Verzeichnis die Domain bedient.
SFTP_REMOTE_DIR=/public_html
